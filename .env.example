# Danny local container configuration.
# Copy to .env and fill in real values. .env is ignored by Git; never commit
# real credentials, and no secret is baked into an image.

# ---- OpenAI-compatible model provider ----
# The service reads the endpoint and model name. The API key is injected as an
# environment variable for the provider client; it is never written to a log,
# a health response, or an image layer.
DANNY_MODEL_ENDPOINT=
DANNY_MODEL_NAME=
DANNY_MODEL_API_KEY=

# ---- Host publication (loopback-only by contract) ----
DANNY_HOST_PORT=8080

# ---- Storage ----
# The default Compose project uses SQLite; the PostgreSQL override supplies its
# own driver and database URL. Set a real POSTGRES_PASSWORD before using it.
POSTGRES_PASSWORD=change-me

# ---- Scheduling and parser ----
DANNY_SCHEDULER_TIMEZONE=UTC
DANNY_PARSER_BASE_IMAGE=docker.1ms.run/library/python:3.13-slim

# ---- Build images ----
# Override these to use a local mirror or a pinned digest.
DANNY_NODE_BASE_IMAGE=docker.1ms.run/library/node:22-alpine
DANNY_GO_BASE_IMAGE=docker.1ms.run/library/golang:1.26-alpine
DANNY_RUNTIME_BASE_IMAGE=docker.1ms.run/library/alpine:3.20
DANNY_POSTGRES_IMAGE=docker.1ms.run/library/postgres:16-alpine
